  "components": {
    "schemas": {
      "AIInterpretation": {
        "properties": {
          "interpretation_id": {
            "type": "string",
            "minLength": 1,
            "title": "Interpretation Id"
          },
          "target_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Ref",
            "description": "Target candidate or metric ID interpreted"
          },
          "type": {
            "$ref": "#/components/schemas/AIInterpretationType"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text"
          },
          "evidence_refs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Refs"
          },
          "model_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Name"
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version"
          },
          "prompt_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt Version"
          },
          "generated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Generated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "interpretation_id",
          "type",
          "text"
        ],
        "title": "AIInterpretation"
      },
      "AIInterpretationType": {
        "type": "string",
        "enum": [
          "hypothesis",
          "explanatory",
          "limitation"
        ],
        "title": "AIInterpretationType"
      },
      "AnalysisResultPayload": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "0.2.0",
            "title": "Schema Version",
            "default": "0.2.0"
          },
          "analysis_id": {
            "type": "string",
            "minLength": 1,
            "title": "Analysis Id"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "publication_state": {
            "$ref": "#/components/schemas/PublicationState",
            "default": "internal_draft"
          },
          "source": {
            "$ref": "#/components/schemas/SourceMetadata"
          },
          "capabilities": {
            "$ref": "#/components/schemas/CapabilityReport"
          },
          "kpis": {
            "items": {
              "$ref": "#/components/schemas/ProcessKPI"
            },
            "type": "array",
            "title": "Kpis"
          },
          "candidate_bottlenecks": {
            "items": {
              "$ref": "#/components/schemas/CandidateBottleneck"
            },
            "type": "array",
            "title": "Candidate Bottlenecks"
          },
          "ai_interpretations": {
            "items": {
              "$ref": "#/components/schemas/AIInterpretation"
            },
            "type": "array",
            "title": "Ai Interpretations"
          },
          "simulated_scenarios": {
            "items": {
              "$ref": "#/components/schemas/SimulationScenarioResult"
            },
            "type": "array",
            "title": "Simulated Scenarios"
          },
          "limitations": {
            "items": {
              "$ref": "#/components/schemas/DatasetLimitation"
            },
            "type": "array",
            "title": "Limitations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "analysis_id",
          "timestamp",
          "source",
          "capabilities"
        ],
        "title": "AnalysisResultPayload"
      },
      "ApprovalRequest": {
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1,
            "title": "Candidate Id"
          },
          "countermeasure_id": {
            "type": "string",
            "minLength": 1,
            "title": "Countermeasure Id"
          },
          "workstation": {
            "type": "string",
            "minLength": 1,
            "title": "Workstation"
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "title": "Action"
          },
          "supervisor_notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supervisor Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "candidate_id",
          "countermeasure_id",
          "workstation",
          "action"
        ],
        "title": "ApprovalRequest"
      },
      "ApprovalResponse": {
        "properties": {
          "approval_id": {
            "type": "string",
            "title": "Approval Id"
          },
          "analysis_id": {
            "type": "string",
            "title": "Analysis Id"
          },
          "candidate_id": {
            "type": "string",
            "title": "Candidate Id"
          },
          "countermeasure_id": {
            "type": "string",
            "title": "Countermeasure Id"
          },
          "status": {
            "type": "string",
            "const": "approved",
            "title": "Status"
          },
          "approver_id": {
            "type": "string",
            "title": "Approver Id",
            "description": "Derived from authenticated user context"
          },
          "approval_timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Approval Timestamp"
          },
          "supervisor_notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supervisor Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "approval_id",
          "analysis_id",
          "candidate_id",
          "countermeasure_id",
          "status",
          "approver_id",
          "approval_timestamp"
        ],
        "title": "ApprovalResponse"
      },
      "Body_create_analysis": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Event log in CSV or XES format"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_create_analysis"
      },
      "Body_upload_dataset": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Event log in CSV or XES format"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_dataset"
      },
      "BottleneckSeverity": {
        "type": "string",
        "enum": [
          "LOW",
          "MEDIUM",
          "HIGH",
          "CRITICAL"
        ],
        "title": "BottleneckSeverity"
      },
      "BottleneckTarget": {
        "properties": {
          "target_type": {
            "$ref": "#/components/schemas/TargetType",
            "description": "Target type: workstation, activity, or transition"
          },
          "target_name": {
            "type": "string",
            "title": "Target Name",
            "description": "Identifier of the target activity or station"
          },
          "source_activity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Activity",
            "description": "Source activity if target is a transition"
          },
          "station_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Station Id",
            "description": "Physical workstation ID if explicitly mapped"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "target_type",
          "target_name"
        ],
        "title": "BottleneckTarget"
      },
      "CandidateBottleneck": {
        "properties": {
