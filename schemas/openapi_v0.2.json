    "/api/v1/analyses": {
      "post": {
        "tags": [
          "Analysis ingestion and processing"
        ],
        "summary": "Create an analysis",
        "description": "Accepts a CSV or XES event log. The contract scaffold validates basic upload constraints. Actual ingestion, PM4Py analysis and result persistence are not implemented in this file.",
        "operationId": "create_analysis_api_v1_analyses_post",
        "parameters": [
          {
            "name": "case_id_col",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "default": "Case_ID",
              "title": "Case Id Col"
            }
          },
          {
            "name": "activity_col",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "default": "Activity",
              "title": "Activity Col"
            }
          },
          {
            "name": "timestamp_col",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "default": "Timestamp",
              "title": "Timestamp Col"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_analysis_api_v1_analyses_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResultPayload"
                }
              }
            }
          },
          "413": {
            "description": "Uploaded file exceeds the configured size limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported event-log format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Request validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "501": {
            "description": "The corresponding application service is not implemented yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
