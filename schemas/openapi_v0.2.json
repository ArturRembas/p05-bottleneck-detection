{
  "openapi": "3.1.0",
  "info": {
    "title": "P05 \u2014 Bottleneck Detection in Processes API",
    "description": "Component of the AI Puzzle Framework. Exposes OpenAPI 3.1 compliant endpoints for process bottleneck detection, capacity constraints, and operational KPIs.",
    "version": "0.2.0"
  },
  "paths": {
    "/api/v1/analyses": {
      "post": {
        "tags": [
          "Analysis Ingestion & Processing"
        ],
        "summary": "Create Analysis",
        "description": "Ingests an event log, performs deterministic process discovery via pm4py,\n\nand returns a fully structured AnalysisResultPayload matching SRS v0.2 \u00a7\n7.1.",
        "operationId": "create_analysis_api_v1_analyses_post",
        "parameters": [
          {
            "name": "case_id_col",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Column name for Case Identifier",
              "default": "Case_ID",
              "title": "Case Id Col"
            },
            "description": "Column name for Case Identifier"
          },
          {
            "name": "activity_col",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Column name for Activity label",
              "default": "Activity",
              "title": "Activity Col"
            },
            "description": "Column name for Activity label"
          },
          {
            "name": "timestamp_col",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Column name for Event Timestamp",
              "default": "Timestamp",
              "title": "Timestamp Col"
            },
            "description": "Column name for Event Timestamp"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_analysis_api_v1_analyses_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResultPayload"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analyses/{analysis_id}/bottlenecks": {
      "get": {
        "tags": [
          "Interoperability P06 / P20"
        ],
        "summary": "Get Bottlenecks",
        "description": "Returns ranked candidate bottlenecks and capacity constraints for\n\ndownstream consumers: P06 (Production Scheduling) and P20 (Resource\nAllocation).",
        "operationId": "get_bottlenecks_api_v1_analyses__analysis_id__bottlenecks_get",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Analysis Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CandidateBottleneck"
                  },
                  "title": "Response Get Bottlenecks Api V1 Analyses  Analysis Id  Bottlenecks Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analyses/{analysis_id}/kpis": {
      "get": {
        "tags": [
          "Interoperability P17"
        ],
        "summary": "Get Process Kpis",
        "description": "Supplies aggregated process efficiency metrics and lead times to P17\n\n(Data Analytics).",
        "operationId": "get_process_kpis_api_v1_analyses__analysis_id__kpis_get",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Analysis Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProcessKPI"
                  },
                  "title": "Response Get Process Kpis Api V1 Analyses  Analysis Id  Kpis Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analyses/{analysis_id}/full-report": {
      "get": {
        "tags": [
          "Full Analysis Result"
        ],
        "summary": "Get Full Analysis",
        "description": "Retrieves the complete, validated structured analysis report adhering to\n\nSRS v0.2 \u00a7 7.1.",
        "operationId": "get_full_analysis_api_v1_analyses__analysis_id__full_report_get",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Analysis Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResultPayload"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analyses/{analysis_id}/countermeasures/approve": {
      "post": {
        "tags": [
          "Human-in-the-Loop Governance (D24/UC11)"
        ],
        "summary": "Approve Countermeasure",
        "description": "Enforces the mandatory Human-in-the-Loop governance gate.\n\nRecords explicit human supervisor authorization before countermeasures are\ndispatched to downstream scheduling modules.",
        "operationId": "approve_countermeasure_api_v1_analyses__analysis_id__countermeasures_approve_post",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Analysis Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analyses/{analysis_id}/export-bpmn": {
      "get": {
        "tags": [
          "Export & Interoperability P21"
        ],
        "summary": "Export Bpmn",
        "description": "Exports discovered process topology as a standard BPMN 2.0 XML model for\n\nP21 (What-If Simulator).",
        "operationId": "export_bpmn_api_v1_analyses__analysis_id__export_bpmn_get",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Analysis Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AIInterpretation": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Assertion type: hypothesis, explanatory, or limitation",
            "default": "hypothesis"
          },
          "text": {
            "type": "string",
            "title": "Text",
            "description": "Contextual reasoning diagnosis or proposed countermeasure"
          },
          "evidence_refs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Refs",
            "description": "Traceable references to deterministic calculation records"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "AIInterpretation"
      },
      "AnalysisResultPayload": {
        "properties": {
          "schema_version": {
            "type": "string",
            "title": "Schema Version",
            "default": "draft-0.2"
          },
          "analysis_id": {
            "type": "string",
            "title": "Analysis Id",
            "description": "Unique session identifier for this analysis"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "source": {
            "additionalProperties": true,
            "type": "object",
            "title": "Source",
            "description": "Input metadata: log version, input hash, and time semantics"
          },
          "capabilities": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Capabilities",
            "description": "Admissible capabilities based on ingested schema attributes"
          },
          "kpis": {
            "items": {
              "$ref": "#/components/schemas/ProcessKPI"
            },
            "type": "array",
            "title": "Kpis",
            "description": "List of measured, derived, or unavailable KPIs"
          },
          "candidate_bottlenecks": {
            "items": {
              "$ref": "#/components/schemas/CandidateBottleneck"
            },
            "type": "array",
            "title": "Candidate Bottlenecks",
            "description": "Ranked candidate bottlenecks identified by analytical core"
          },
          "ai_interpretations": {
            "items": {
              "$ref": "#/components/schemas/AIInterpretation"
            },
            "type": "array",
            "title": "Ai Interpretations",
            "description": "Cognitive reasoning hypotheses and recommended interventions"
          },
          "simulated_scenarios": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Simulated Scenarios",
            "description": "Simulation scenario outcomes and counterfactual estimates"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations",
            "description": "Explicit disclaimers regarding unmeasurable phenomena"
          }
        },
        "type": "object",
        "required": [
          "analysis_id",
          "source",
          "capabilities"
        ],
        "title": "AnalysisResultPayload"
      },
      "ApprovalRequest": {
        "properties": {
          "workstation": {
            "type": "string",
            "title": "Workstation",
            "description": "Workstation target of the countermeasure"
          },
          "action": {
            "type": "string",
            "title": "Action",
            "description": "Operational action approved by the supervisor"
          },
          "supervisor_notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supervisor Notes",
            "description": "Optional notes logged during review"
          }
        },
        "type": "object",
        "required": [
          "workstation",
          "action"
        ],
        "title": "ApprovalRequest"
      },
      "ApprovalResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Execution status of the approval gate"
          },
          "analysis_id": {
            "type": "string",
            "title": "Analysis Id",
            "description": "Unique identifier of the validated analysis run"
          },
          "workstation": {
            "type": "string",
            "title": "Workstation",
            "description": "Target workstation approved for intervention"
          },
          "action": {
            "type": "string",
            "title": "Action",
            "description": "Approved countermeasure action"
          },
          "approval_timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Approval Timestamp"
          },
          "notified_partners": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notified Partners",
            "description": "External modules informed via interoperability layer"
          }
        },
        "type": "object",
        "required": [
          "status",
          "analysis_id",
          "workstation",
          "action"
        ],
        "title": "ApprovalResponse"
      },
      "Body_create_analysis_api_v1_analyses_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Event log file in CSV or XES format"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_create_analysis_api_v1_analyses_post"
      },
      "BottleneckSeverity": {
        "type": "string",
        "enum": [
          "LOW",
          "MEDIUM",
          "HIGH",
          "CRITICAL"
        ],
        "title": "BottleneckSeverity"
      },
      "CandidateBottleneck": {
        "properties": {
          "activity": {
            "type": "string",
            "title": "Activity",
            "description": "Name of the process workstation or activity"
          },
          "rank": {
            "type": "integer",
            "title": "Rank",
            "description": "Congestion ranking index (1 indicates highest impact)"
          },
          "method": {
            "type": "string",
            "title": "Method",
            "description": "Underlying algorithmic discovery method",
            "default": "statistical_inter_event_gap"
          },
          "severity": {
            "$ref": "#/components/schemas/BottleneckSeverity",
            "description": "Estimated severity level"
          },
          "waiting_time_hours": {
            "type": "number",
            "title": "Waiting Time Hours",
            "description": "Observed mean transition or queue interval in hours"
          },
          "evidence_refs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Refs",
            "description": "Traceable references to KPI identifiers or run logs"
          },
          "validation": {
            "$ref": "#/components/schemas/ValidationStatus",
            "description": "Human oversight governance status",
            "default": "pending"
          }
        },
        "type": "object",
        "required": [
          "activity",
          "rank",
          "severity",
          "waiting_time_hours"
        ],
        "title": "CandidateBottleneck"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MetricStatus": {
        "type": "string",
        "enum": [
          "measured",
          "derived",
          "estimated",
          "unavailable"
        ],
        "title": "MetricStatus"
      },
      "ProcessKPI": {
        "properties": {
          "metric": {
            "type": "string",
            "title": "Metric",
            "description": "Metric identifier (e.g., observed_transition_gap, throughput_time)"
          },
          "value": {
            "type": "number",
            "title": "Value",
            "description": "Calculated numerical value"
          },
          "unit": {
            "type": "string",
            "title": "Unit",
            "description": "Unit of measurement (min, hours, ratio)"
          },
          "status": {
            "$ref": "#/components/schemas/MetricStatus",
            "description": "Data reliability status reflecting available log attributes"
          },
          "sample_size": {
            "type": "integer",
            "title": "Sample Size",
            "description": "Number of observed cases or events in sample"
          }
        },
        "type": "object",
        "required": [
          "metric",
          "value",
          "unit",
          "status",
          "sample_size"
        ],
        "title": "ProcessKPI"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "ValidationStatus": {
        "type": "string",
        "enum": [
          "pending",
          "approved",
          "rejected"
        ],
        "title": "ValidationStatus"
      }
    }
  }
}